# Copy this file to .env and fill it in. NEVER commit .env.
RAKTAVEDA_DB_PASSWORD=change-me-to-a-long-random-value

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# If you lose this key, encrypted phone numbers cannot be recovered.
RAKTAVEDA_DATA_KEY=

# true = OTP codes are returned in API responses (development only).
OTP_DEV_MODE=true

# Admin account is created at startup if both are set (password: 12-72 chars).
RAKTAVEDA_ADMIN_EMAIL=
RAKTAVEDA_ADMIN_PASSWORD=

RAKTAVEDA_ALLOWED_ORIGINS=http://localhost:3000
RAKTAVEDA_REQUIRE_HTTPS=false
RAKTAVEDA_API_DOCS_ENABLED=true

# true = load fictional TEST DATA (institutions and 3 donors with 555 phone numbers) at start.
# Never true on a real server.
RAKTAVEDA_SEED_TEST_DATA=false

# dev = only records that a push was sent. See docs/SECURITY.md before changing.
RAKTAVEDA_PUSH_PROVIDER=dev

# AI assistant (optional). Leave AI_API_KEY empty to use the built-in fake assistant.
# The key is a secret: never commit it. The real service is usually paid.
AI_API_KEY=
AI_MODEL=
